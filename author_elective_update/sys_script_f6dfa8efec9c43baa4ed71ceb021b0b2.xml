        <script><![CDATA[        (function executeRule(current, previous /*null when async*/) {

  if (!current.short_description || !current.u_request_type) {
    return;
  }

  var shortDescription = current.short_description.toString();
  var requestType = current.u_request_type.getDisplayValue();

  var matchPercentage = 0;
  if (shortDescription.toLowerCase().indexOf(requestType.toLowerCase()) !== -1) {
    matchPercentage = 100;
  } else {
    try {
      var restMessage = new sn_ws.RESTMessageV2();
      restMessage.setEndpoint('https://api.anthropic.com/v1/messages');
      restMessage.setHttpMethod('POST');

      // ]]>🔑<![CDATA[ Load API key using Credential Alias
      // var cred = sn_auth.CredentialAlias.getCredential('x_58872_needit.Claude_Code_Alias');
      
      var cred = new sn_cc.StandardCredentialsProvider().getAuthCredentialByID("59d0744f83636210cc79f7c6feaad3e2");

      var apiKey = null;
      if (cred) {
        apiKey = cred.getPassword();  // securely retrieves the stored API Key
      } else {
        gs.error('Claude API Credential Alias "x_58872_needit.Claude_Code_Alias" not found');
        matchPercentage = calculateSimpleMatch(shortDescription, requestType);
        return;
      }

      restMessage.setRequestHeader('x-api-key', apiKey);
      restMessage.setRequestHeader('anthropic-version', '2023-06-01');
      restMessage.setRequestHeader('content-type', 'application/json');

      var requestBody = {
        "model": "claude-3-5-sonnet-20241022",
        "max_tokens": 1024,
        "messages": [
          {
            "role": "user",
            "content": "Bewerte wie gut die folgende Kurzbeschreibung zum angegebenen Request Type passt. Gib nur eine Zahl zwischen 0 und 100 zurück (Prozent der Übereinstimmung).\n\nRequest Type: " + requestType + "\nKurzbeschreibung: " + shortDescription
          }
        ]
      };

      restMessage.setRequestBody(JSON.stringify(requestBody));

      var response = restMessage.execute();
      var responseBody = response.getBody();

      if (response.getStatusCode() == 200) {
        var claudeResponse = JSON.parse(responseBody);
        if (claudeResponse.content && claudeResponse.content.length > 0) {
          var content = claudeResponse.content[0].text;
          var percentMatch = content.match(/\d+/);
          if (percentMatch) {
            matchPercentage = parseInt(percentMatch[0]);
          }
        }
      } else {
        gs.error('Claude API Fehler: ' + response.getStatusCode() + ' - ' + responseBody);
        matchPercentage = calculateSimpleMatch(shortDescription, requestType);
      }
    } catch (e) {
      gs.error('Fehler beim Claude API Aufruf: ' + e.message);
      matchPercentage = calculateSimpleMatch(shortDescription, requestType);
    }
  }

  gs.info('Short Description Validation - Request Type: "' + requestType + '", Short Description: "' + shortDescription + '", Match Percentage: ' + matchPercentage + '%');

  if (matchPercentage < 50) {
    gs.info('WARNUNG für Record ' + current.sys_id + ': Die Kurzbeschreibung entspricht nur zu ' + matchPercentage + '% dem gewählten Request Type "' + requestType + '"');

    current.work_notes = 'System-Hinweis: Die Kurzbeschreibung entspricht nur zu ' + matchPercentage + '% dem gewählten Request Type "' + requestType + '". Bitte überprüfen Sie Ihre Eingabe.';
    current.update();
  }

  function calculateSimpleMatch(desc, reqType) {
    var descWords = desc.toLowerCase().split(/\s+/);
    var reqTypeWords = reqType.toLowerCase().split(/\s+/);
    var matches = 0;

    for (var i = 0; i < reqTypeWords.length; i++) {
      for (var j = 0; j < descWords.length; j++) {
        if (descWords[j].indexOf(reqTypeWords[i]) !== -1 || reqTypeWords[i].indexOf(descWords[j]) !== -1) {
          matches++;
          break;
        }
      }
    }

    return Math.round((matches / reqTypeWords.length) * 100);
  }

})(current, previous);]]></script>
